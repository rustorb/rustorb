    lambda d: d.set_length(2), lambda d: d.seek(1), lambda d: d.insert_long(4),
    lambda d: d.set_length(4), lambda d: str(d.current_component().get_long())))


def grow_from_minus1(d):
    d.set_length(2)
    d.seek(-1)
    d.set_length(4)
    s = b(d.current_component() is None)
    d.insert_long(8)
    e = d.copy()
    e.seek(2)
    return "%s %s" % (s, e.get_long())


