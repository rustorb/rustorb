def set_members(change, result=None):
    def f():
        d = new(s_tc)
        m = d.get_members()
        change(m)
        d.set_members(m)
        return result
    return f


def rename(m):
    m[1].id = "zz"


def empty_names(m):
    for p in m:
        p.id = ""


case("struct.set_members_wrong_name", set_members(rename))
case("struct.set_members_empty_names", set_members(empty_names, b(True)))
case("struct.set_members_short", set_members(lambda m: m.pop()))
case("struct.set_members_wrong_type",
     set_members(lambda m: setattr(m[0], "value", CORBA.Any(short, 1))))
case("struct.set_members_unaliased",
     set_members(lambda m: setattr(m[2], "value", CORBA.Any(long_, 4)), b(True)))


def set_members_position():
