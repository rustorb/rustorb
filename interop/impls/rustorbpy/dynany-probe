case("struct.assign_wrong", lambda: new(s_tc).assign(new(long_)))


def destroy_component():
    c = new(s_tc).current_component()
    c.destroy()
    c.insert_long(2)
    return str(c.get_long())


def destroyed():
    d = new(s_tc)
    c = d.current_component()
    d.destroy()
