#!/usr/bin/env python3
"""The DynAny probe of impls/omniorb-cpp/dynany_probe.cc with rustorb's
Python binding (rustorb.DynamicAny): the same cases, printed the same way.
run-dynany-probe.sh compares the output with expected/dynany-probe-rustorb.txt,
as the Rust probe's (the same core).

Run it after build.sh, which puts the rustorb package in lib/.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "lib"))

from rustorb import CORBA, DynamicAny  # noqa: E402

DA = DynamicAny.DynAny


def case(name, f):
    try:
        out = f()
        out = "" if out is None else out
    except DA.TypeMismatch:
        out = "TypeMismatch"
    except DA.InvalidValue:
        out = "InvalidValue"
    except DynamicAny.DynAnyFactory.InconsistentTypeCode:
        out = "InconsistentTypeCode"
    except DynamicAny.MustTruncate:
        out = "MustTruncate"
    except CORBA.SystemException as e:
        out = type(e).__name__
    print("%s: %s" % (name, out))


def b(v):
    return "true" if v else "false"


def q(s):
    return '"%s"' % s


def kind(k):
    return str(k)


def position(d):
    """The current position, found by counting the components after it
    (this moves the position to -1, so it comes last in a case)."""
    if d.current_component() is None:
        return -1
    after = 0
    while d.next():
        after += 1
    return d.component_count() - 1 - after


orb = CORBA.ORB_init([sys.argv[0]])
f = orb.resolve_initial_references("DynAnyFactory")
new = f.create_dyn_any_from_type_code
SM = CORBA.StructMember


def UM(name, label, tc):
    return CORBA.UnionMember(name, label, tc)


long_ = CORBA.TC_long
string = CORBA.TC_string
count = orb.create_alias_tc("IDL:P/Count:1.0", "Count", long_)
s_tc = orb.create_struct_tc("IDL:P/S:1.0", "S", [SM("a", long_), SM("b", string), SM("c", count)])
e_tc = orb.create_exception_tc("IDL:P/E:1.0", "E", [])
color = orb.create_enum_tc("IDL:P/Color:1.0", "Color", ["RED", "GREEN", "BLUE"])
default = CORBA.Any(CORBA.TC_octet, 0)
u_tc = orb.create_union_tc("IDL:P/U:1.0", "U", long_, [
    UM("x", CORBA.Any(long_, 1), long_), UM("y", CORBA.Any(long_, 2), string),
    UM("y", CORBA.Any(long_, 3), string), UM("z", default, CORBA.TC_boolean)])
d_tc = orb.create_union_tc("IDL:P/D:1.0", "D", long_, [
    UM("z", default, CORBA.TC_boolean), UM("x", CORBA.Any(long_, 0), long_)])
short = CORBA.TC_short
n_tc = orb.create_union_tc("IDL:P/N:1.0", "N", short, [
    UM("x", CORBA.Any(short, 5), long_), UM("y", CORBA.Any(short, 2), string)])
boolean = CORBA.TC_boolean
b_tc = orb.create_union_tc("IDL:P/B:1.0", "B", boolean, [
    UM("t", CORBA.Any(boolean, True), long_), UM("f", CORBA.Any(boolean, False), string)])
seq_tc = orb.create_sequence_tc(0, long_)
bseq_tc = orb.create_sequence_tc(2, long_)
arr_tc = orb.create_array_tc(3, long_)
money = orb.create_fixed_tc(5, 2)
bstr = orb.create_string_tc(3)
v_tc = orb.create_value_tc("IDL:P/V:1.0", "V", CORBA.VM_NONE, None,
                           [CORBA.ValueMember("n", "", "", "", long_, None, CORBA.PUBLIC_MEMBER)])
box_tc = orb.create_value_box_tc("IDL:P/LBox:1.0", "LBox", long_)


def run(*steps):
    """Calls each step; returns the last result."""
    r = None
    for s in steps:
        r = s()
    return r


# -- creation from TypeCodes and positions
case("long.count", lambda: str(new(long_).component_count()))
case("long.get", lambda: str(new(long_).get_long()))
case("long.seek0", lambda: b(new(long_).seek(0)))
case("long.next", lambda: b(new(long_).next()))
case("long.current_component", lambda: b(new(long_).current_component() is None))
case("long.get_short", lambda: run(lambda: new(long_).get_short(), lambda: None))
case("long.insert_short", lambda: new(long_).insert_short(1))


def alias_insert():
    d = new(count)
    d.insert_long(7)
    return str(d.get_long())


case("alias.insert_long", alias_insert)
case("alias.type", lambda: kind(new(count).type().kind()))
case("string.get", lambda: q(new(string).get_string()))
case("bstring.insert_long", lambda: new(bstr).insert_string("abcd"))
case("bstring.insert_ok", lambda: run(lambda: new(bstr).insert_string("abc"), lambda: b(True)))
case("typecode.get", lambda: kind(new(CORBA.TC_TypeCode).get_typecode().kind()))
case("any.get", lambda: kind(new(CORBA.TC_any).get_any().typecode().kind()))
case("any.count", lambda: str(new(CORBA.TC_any).component_count()))
case("objref.get", lambda: b(new(CORBA.TC_Object).get_reference() is None))
case("principal", lambda: kind(new(CORBA.TC_Principal).to_any().typecode().kind()))
case("longdouble", lambda: kind(new(CORBA.TC_longdouble).to_any().typecode().kind()))


