def destroyed_top():
    d = new(s_tc)
    d.destroy()
    d.component_count()


def copy_independent():
    d = new(s_tc)
    d.copy().insert_long(5)
    return str(d.current_component().get_long())


def equal():
    d = new(s_tc)
    e = d.copy()
    s = b(d.equal(e))
    e.insert_long(1)
    return s + b(d.equal(e))


case("struct.destroy_component", destroy_component)
