#!/bin/sh
# Java interop server on the rustorb Java runtime with stubs and skeletons
# from JacORB's IDL compiler. run-matrix.sh builds it on the host (build.sh)
# and mounts this directory, with classes/ and lib/, into the container.
here="$(dirname "$0")"
exec "${RUSTORB_JAVA:-java}" --enable-native-access=ALL-UNNAMED -Drustorb.ffi.library="$here/lib/librustorb_ffi.so" -cp "$here/classes" interop.Server "$@"
