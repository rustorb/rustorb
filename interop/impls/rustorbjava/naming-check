#!/bin/sh
# rustorb Java naming check (probe/interop/NamingCheck.java). run-naming-check.sh
# builds it on the host (build.sh) and mounts this directory, with classes/
# and lib/, into the client container.
here="$(dirname "$0")"
exec "${RUSTORB_JAVA:-java}" --enable-native-access=ALL-UNNAMED -Djava.library.path="$here/lib" -cp "$here/classes" \
  interop.NamingCheck "$@"
