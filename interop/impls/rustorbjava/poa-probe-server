#!/bin/sh
# rustorb Java POA probe server. run-poa-probe.sh builds it on the host
# (build.sh) and mounts this directory, with classes/ and lib/, into the
# server container.
here="$(dirname "$0")"
exec "${RUSTORB_JAVA:-java}" --enable-native-access=ALL-UNNAMED -Djava.library.path="$here/lib" -cp "$here/classes" \
  interop.PoaProbeServer "$@"
