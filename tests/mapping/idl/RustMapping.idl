// Constructs of the IDL to Rust mapping (docs/rust-mapping.md) that the
// test IDLs of the interop tests do not use. The generated code is checked
// in (tests/generated/rust_mapping.rs) and tested by tests/rust_mapping.rs.

#pragma prefix "rustorb.org"

const long GLOBAL_LIMIT = 10;

struct GlobalPoint {
  long x;
  long y;
};

interface GlobalIface {
  long ping(in long v);
};

module RustMapping {

  // --- constants of every kind ---
  const short C_SHORT = -3;
  const unsigned short C_USHORT = 3;
  const long C_LONG = 1 << 20;
  const long C_MIN = -2147483648;
  const unsigned long C_ULONG = 4000000000;
  const long long C_LONGLONG = -9000000000;
  const unsigned long long C_ULONGLONG = 18000000000000000000;
  const float C_FLOAT = 1.5;
  const double C_DOUBLE = 1.0 / 4.0;
  const boolean C_TRUE = TRUE;
  const char C_CHAR = 'q';
  const wchar C_WCHAR = L'w';
  const string C_STRING = "ab" "cd\n";
  const wstring C_WSTRING = L"wide";
  const octet C_OCTET = 255;
  const long C_EXPR = C_LONG * 2 + C_SHORT;
  const long maxCount = 5;

  enum Fruit { APPLE, BANANA, CHERRY_PIE };
  const Fruit C_ENUM = BANANA;

  // --- typedefs ---
  typedef long Count;
  typedef Count Count2;
  typedef string<8> ShortString;
  typedef sequence<long, 5> BoundedSeq;
  typedef sequence<sequence<string> > NestedSeq;
  typedef short Grid[2][2];
  typedef Fruit FruitAlias;
  typedef sequence<octet> Octets;
  typedef sequence<wstring> WideNames;

  struct Pair {
    Count first;
    Count2 second;
  };
  typedef Pair PairAlias;
  typedef fixed<5, 2> Money;
  const Money C_FIXED = 12.50d;
  typedef sequence<Pair> PairSeq;

  // --- long double ---
  const long double C_QUAD = 0.5;
  struct Quads {
    long double one;
    sequence<long double> many;
    long double pair[2];
  };

  // --- recursive struct and union ---
  struct Tree {
    string label;
    sequence<Tree> children;
  };

  union Node switch (short) {
    case 1: long leaf;
    case 2: sequence<Node> branch;
  };

  // --- unions with every kind of discriminator ---
  union ByBool switch (boolean) {
    case TRUE: long yes;
    case FALSE: string no;
  };

  union ByChar switch (char) {
    case 'a': long a;
    case 'b':
    case 'c': string bc;
  };

  union ByEnum switch (Fruit) {
    case APPLE: long apple_count;
    case CHERRY_PIE: string cherry_name;
    default: boolean other;
  };

  union ByEnumImplicit switch (Fruit) {
    case APPLE: long apple_count;
  };

  union ByULongLong switch (unsigned long long) {
    case 7: double seven;
  };

  union WithArray switch (long) {
    case 0: Grid cells;
    case 1: Pair two;
  };

  // --- arrays and anonymous types in members, names that are Rust keywords ---
  struct Holder {
    long numbers[3];
    sequence<Pair> pairs;
    Grid cells;
    ShortString tag;
    BoundedSeq bounded;
    any extra;
    Object target;
    Money price;
    wstring<4> wide;
    wchar letter;
    char ascii;
    Octets data;
    WideNames names;
    long type;
    boolean self;
    string camelCaseName;
  };

  // --- types defined inside other types ---
  struct Outer {
    struct Inner {
      long v;
    } nested;
    enum Mode { ON, OFF } switch_mode;
  };

  // --- exceptions ---
  exception Failure {
    long code;
    string message;
    Fruit kind;
  };
  exception Empty {};

  // --- interfaces, inheritance and nested definitions ---
  interface Later;

  interface Base {
    const long BASE_CONST = 7;
    typedef sequence<Later> LaterSeq;
    exception BaseError { string why; };
    struct BaseInfo { long id; };

    readonly attribute long id;
    attribute string label;
    void base_op() raises (BaseError);
  };

  interface Derived : Base {
    long derived_op(in long a, inout long b, out long c) raises (Failure, Empty);
    oneway void notify(in string msg);
    Base as_base();
    LaterSeq laters();
    void getValue(in string match, out string result, inout Pair pair);
    void take(in Holder h, in Pair p, in Fruit f, in Octets o, in Later l, in Object x,
              in any a, in Money m, in Grid g);
  };

  interface Other {
    void other_op();
  };

  interface Multi : Derived, Other {
    void multi_op(in Base::BaseInfo info);
  };

  interface Later {
    Later next();
  };

  typedef Base BaseAlias;
  typedef ByBool ByBoolAlias;
  typedef sequence<Base> BaseSeq;

  // --- valuetypes ---
  valuetype Shape {
    public string name;
    private long secret;
  };

  valuetype Circle : truncatable Shape {
    public double radius;
  };

  valuetype Link {
    public long id;
    public Link next;
  };

  valuetype LongBox long;
  valuetype PairBox Pair;

  // A custom valuetype: its state implements CustomMarshal.
  custom valuetype Tagged {
    public long tag;
    public string text;
  };

  // A valuetype with operations that supports an interface: its state
  // implements GaugeOperations, and an instance is a MeterServant.
  interface Meter {
    long reading();
  };
  valuetype Gauge supports Meter {
    public long level;
    long scaled(in long by);
    factory init(in long level);
  };

  struct Drawing {
    Shape main;
    sequence<Shape> others;
    LongBox count;
  };

  interface Canvas {
    Shape echo_shape(in Shape s);
    Drawing echo_drawing(in Drawing d);
    LongBox echo_box(in LongBox b);
    Tagged echo_tagged(in Tagged t);
    Gauge echo_gauge(in Gauge g);
    long read_meter(in Meter m);
  };

  // --- abstract interfaces ---
  // An abstract interface is an enum: an object reference or a value.
  abstract interface Labeled {
    string label_of();
  };
  abstract interface Titled : Labeled {
    attribute long rank;
    void retitle(inout string title) raises (Failure);
  };
  interface Book : Titled {
    long pages();
  };
  // Its instances pass as Titled (and Labeled).
  valuetype Note supports Titled {
    public string text;
    public long level;
  };
  struct TitledPair {
    Titled first;
    Labeled second;
  };
  interface Shelf {
    Titled echo_titled(in Titled t);
    TitledPair echo_titled_pair(in TitledPair p);
    string label(in Labeled l);
    Book make_book(in string title);
  };

  // --- local interfaces ---
  // A local interface is a trait only.
  local interface Hook {
    long fire(in long n, in Hook next);
  };
  local interface LoudHook : Hook {
    void shout(in string s) raises (Failure);
    readonly attribute Pair last;
  };
  valuetype Bell supports Hook {
    public long rings;
  };

  // --- abstract valuetypes ---
  // An abstract valuetype is a handle of an instance of a derived type,
  // whose Operations trait has the operations.
  abstract valuetype Priced {
    double price();
  };
  abstract valuetype Discounted : Priced {
    double discounted(in double rate) raises (Failure);
  };
  valuetype Item : Discounted {
    public double base;
    // An operation of a valuetype that raises.
    long stock() raises (Empty);
  };
  typedef sequence<Priced> PricedSeq;
  interface Shop {
    Priced echo_priced(in Priced p);
    double total(in PricedSeq ps);
  };

  // --- nested modules ---
  module Inner {
    const string INNER_NAME = "inner";
    struct InnerStruct {
      Pair two;
      ::GlobalPoint global;
    };
    interface InnerIface : Base {
      InnerStruct get();
    };
  };
};

module RustMapping {
  // A module opened again.
  const long REOPENED = 1;
};
