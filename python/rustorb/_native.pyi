class Request:
    # The native part of a CORBA.Request (the DII). The values are
    # CORBA.Any objects, the types CORBA.TypeCode objects; args are
    # (name, value, flags) tuples, and the outputs the return value and the
    # values of the arguments (None for an out argument without one).
    def __init__(self, target: ObjRef, operation: str) -> None: ...
    def invoke(
        self, args: List[Tuple[str, Any, int]], result: Any, exceptions: List[Any]
    ) -> Tuple[Any, List[Optional[Any]]]: ...
    def send_oneway(self, args: List[Tuple[str, Any, int]], result: Any, exceptions: List[Any]) -> None: ...
    def send_deferred(self, args: List[Tuple[str, Any, int]], result: Any, exceptions: List[Any]) -> None: ...
    def poll_response(self) -> bool: ...
    def get_response(self) -> Tuple[Any, List[Optional[Any]]]: ...

class NativeServerRequest:
    # The native part of a CORBA.ServerRequest (the DSI), valid while the
    # servant's invoke runs.
    def operation(self) -> str: ...
    def arguments(self, params: List[Tuple[str, Any, int]]) -> List[Optional[Any]]: ...
    def set_out_values(self, values: List[Optional[Any]]) -> None: ...
    def set_result(self, value: Any) -> None: ...
    def set_exception(self, value: Any) -> None: ...
