// Constructs of the IDL to C++11 mapping that InteropTest.idl does not use,
// for cpp/tests/test_mapping.cc. Everything here round-trips through
// rustorb-idl -bc++11 stubs and skeletons over GIOP.

#pragma prefix "rustorb.org"

const long GLOBAL_LIMIT = 10;

struct GlobalPoint {
  long x;
  long y;
};

module CxxMapping {

  const short C_SHORT = -3;
  const unsigned long long C_ULONGLONG = 18000000000000000000;
  const double C_DOUBLE = 1.0 / 4.0;
  const boolean C_TRUE = TRUE;
  const char C_CHAR = 'q';
  const wchar C_WCHAR = L'w';
  const string C_STRING = "ab" "cd";
  const wstring C_WSTRING = L"wide";
  const octet C_OCTET = 255;
  const long C_EXPR = (1 << 20) * 2 + C_SHORT;

  enum Fruit { APPLE, BANANA, CHERRY };
  const Fruit C_ENUM = BANANA;

  typedef long Count;
  typedef string<8> ShortString;
  typedef wstring<4> ShortWString;
  typedef sequence<long, 5> BoundedSeq;
  typedef sequence<sequence<string> > NestedSeq;
  typedef short Grid[2][3];
  typedef sequence<boolean> Flags;
  typedef sequence<wchar> WChars;

  typedef fixed<5, 2> Money;
  const fixed C_FIXED = 012.50d;
  const Money C_MONEY = -1.5d;

  typedef long double Quad;
  const long double C_QUAD = 2.5;
  struct Measure {
    Quad value;
    sequence<long double> samples;
  };

  struct Price {
    Money amount;
    fixed<31, 31> tiny;
    sequence<Money> history;
  };

  struct Pair {
    Count first;
    Count second;
  };

  // Recursive struct and union.
  struct Tree {
    string label;
    sequence<Tree> children;
  };

  union Node switch (short) {
    case 1: long leaf;
    case 2: sequence<Node> branch;
  };

  // Unions with every kind of discriminator.
  union ByBool switch (boolean) {
    case TRUE: long yes;
    case FALSE: string no;
  };

  union ByChar switch (char) {
    case 'a': long a;
    case 'b':
    case 'c': string bc;
  };

  union ByEnum switch (Fruit) {
    case APPLE: long apple_count;
    case CHERRY: string cherry_name;
    default: boolean other;
  };

  // No default and not every value used: the implicit default.
  union ByULongLong switch (unsigned long long) {
    case 7: double seven;
  };

  union WithArray switch (long) {
    case 0: Grid cells;
    case 1: Pair two;
  };

  struct Holder {
    long numbers[3];
    sequence<Pair> pairs;
    Grid cells;
    ShortString tag;
    BoundedSeq bounded;
    ShortWString wide;
    Flags flags;
    WChars wchars;
    NestedSeq nested;
    Object target;
    ByEnum choice;
  };

  // Types defined inside other types.
  struct Outer {
    struct Inner {
      long v;
    } nested;
    enum Mode { ON, OFF } switch_mode;
  };

  // C++ keywords as IDL identifiers.
  struct Keywords {
    long _class;
    string _namespace;
  };

  exception Failure {
    long code;
    string message;
    Fruit kind;
  };
  exception Empty {};

  interface Later;

  interface Base {
    const long BASE_CONST = 7;
    exception BaseError { string why; };
    struct BaseInfo { long id; };

    readonly attribute long id;
    attribute string label;
    void base_op(in boolean fail) raises (BaseError);
  };

  interface Derived : Base {
    long derived_op(in long a, inout long b, out long c) raises (Failure, Empty);
    oneway void notify(in string msg);
    Base as_base();
  };

  interface Other {
    string other_op();
  };

  interface Multi : Derived, Other {
    BaseInfo multi_op(in Base::BaseInfo info);
  };

  interface Later {
    Later next();
  };

  typedef sequence<Later> LaterSeq;

  // Every type of the file in and out of one interface.
  interface Types {
    Tree echo_tree(in Tree t);
    Node echo_node(in Node n);
    ByBool echo_by_bool(in ByBool u);
    ByChar echo_by_char(in ByChar u);
    ByEnum echo_by_enum(in ByEnum u);
    ByULongLong echo_by_ulonglong(in ByULongLong u);
    WithArray echo_with_array(in WithArray u);
    Holder echo_holder(in Holder h);
    Outer echo_outer(in Outer o);
    Keywords echo_keywords(in Keywords k);
    GlobalPoint echo_global(in ::GlobalPoint p);
    ShortString echo_short_string(in ShortString s);
    Money echo_money(in Money m, inout Money total, out fixed<3, 0> whole);
    Price echo_price(in Price p);
    Quad echo_quad(in Quad q, inout long double twice, out long double negated);
    Measure echo_measure(in Measure m);
    void fail(in long code) raises (Failure, Empty);
    LaterSeq laters(in long n);
    void _delete(in string what);
  };
};

module CxxMapping {
  // A module opened again.
  const long REOPENED = 1;
};
