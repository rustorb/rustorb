// Callback AMI from Java (AmiTest.java): rustorb-idl -bjava -Wbami.

module AmiJava {
  exception Oops {
    long code;
    string why;
  };

  struct Pair {
    long a;
    string b;
  };
  typedef sequence<Pair> Pairs;

  interface Calc {
    long add(in long a, in long b, out long carry) raises (Oops);
    Pairs swap(inout Pairs ps, in string tag);
    void fail(in unsigned long minor);
    void sleep(in unsigned long ms);
    attribute string label;
    readonly attribute long count;
    oneway void fire(in long n);
  };
};

// A repository id prefix, which the Java package names leave out: a holder
// from another process still finds the exception's Helper.
#pragma prefix "rustorb.org"

module AmiPrefixed {
  exception Busy {
    long retry;
  };

  interface Worker {
    void work(in long n) raises (Busy);
  };
};
