// The interface of the JNI / FFM comparison (java/ffm-prototype).
module Bench {
  typedef sequence<octet> Octets;
  // Sixteen fields: sixteen stream calls each way, as a struct makes them.
  struct Record {
    long f0;
    long f1;
    long f2;
    long f3;
    long f4;
    long f5;
    long f6;
    long f7;
    long f8;
    long f9;
    long f10;
    long f11;
    long f12;
    long f13;
    long f14;
    long f15;
  };
  interface Echo {
    void ping();
    long echo_long(in long v);
    Record echo_record(in Record v);
    Octets echo_octets(in Octets v);
  };
};
