// The DDS type support of rustorb-idl -brust -Wbdds_only, tested by
// tests/dds_mapping.rs (generated/dds_mapping.rs is regenerated by
// generate-rust.sh). The KeyHash* types are the examples of DDS-XTypes 1.3
// 7.6.8, the AutoidHash type the example of 7.3.1.2.1.1.

module DdsMapping {
  // DDS-XTypes 7.6.8, example 1.
  @final struct KeyHash1 {
    @key long id;
    long x;
    long y;
  };

  // DDS-XTypes 7.6.8, example 2.
  @final struct KeyHash2 {
    @key string<12> label;
    @key long long id;
    long x;
    long y;
  };

  // DDS-XTypes 7.6.8, example 3.
  @mutable struct KeyHash3Nested {
    @key long m_long;
    long u;
    long w;
  };

  @mutable struct KeyHash3 {
    @id(40) @key string<16> label;
    @id(30) @key KeyHash3Nested m_nested;
    @id(20) long x;
    @id(10) long y;
  };

  // DDS-XTypes 7.3.1.2.1.1, example 2.
  @autoid(HASH) @mutable struct AutoidHash {
    string color;
    @hashid("shapesize") long size;
  };

  @final struct Point {
    long x;
    long y;
  };

  @bit_bound(8) enum Color {
    RED,
    @value(10) GREEN,
    BLUE,
    @default_literal @value(-3) BLACK
  };

  @bit_bound(12) bitmask Flags {
    READ,
    WRITE,
    @position(11) EXEC
  };

  // No annotation: appendable.
  struct Shape {
    @key string color;
    long x;
    long y;
    long shapesize;
  };

  @appendable struct Everything {
    boolean b;
    octet o;
    int8 i8v;
    short s;
    unsigned short us;
    long l;
    unsigned long ul;
    long long ll;
    unsigned long long ull;
    float f;
    double d;
    char c;
    wchar wc;
    string str;
    string<8> bstr;
    wstring wstr;
    wstring<4> bwstr;
    sequence<long> longs;
    sequence<octet> octets;
    sequence<string, 3> strings;
    sequence<Point> points;
    long matrix[2][3];
    Point corners[2];
    Color color;
    Flags flags;
    @optional long maybe;
    @optional Point maybe_point;
    @external Point boxed;
  };

  @mutable struct Evolving {
    @id(1) long a;
    @id(2) @optional string b;
    @id(3) sequence<Point> c;
    @id(0x4000) @must_understand short far;
  };

  // A newer version of Evolving: one member more.
  @mutable struct EvolvingV2 {
    @id(1) long a;
    @id(2) @optional string b;
    @id(3) sequence<Point> c;
    @id(0x4000) @must_understand short far;
    @id(4) double added;
  };

  // An older version of Evolving: without b and far.
  @mutable struct EvolvingV0 {
    @id(1) long a;
    @id(3) sequence<Point> c;
  };

  // Appendable versions of a type.
  @appendable struct Grown {
    long a;
    long b;
  };

  @appendable struct Small {
    long a;
  };

  @final struct OptionalFinal {
    @optional long a;
    long b;
  };

  union Choice switch (long) {
    case 1: long number;
    case 2:
    case 3: string text;
    default: Point point;
  };

  @final union ByColor switch (Color) {
    case RED: double red;
    case GREEN: Point green;
  };

  @nested struct Inner {
    @key long id;
    Choice choice;
  };

  @topic struct Outer {
    @key Inner inner;
    @key Color color;
    ByColor by_color;
  };

  @default_nested module Nested {
    struct Hidden { long a; };
    @topic struct Shown { long a; };
  };

  typedef sequence<long, 4> Longs;

  @final struct Aliased {
    @key Longs longs;
  };
};
