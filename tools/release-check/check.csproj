<Project Sdk="Microsoft.NET.Sdk">
  <!-- dotnet run -p:RustorbVersion=x.y.z with the package in a local source -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Rustorb" Version="$(RustorbVersion)" />
  </ItemGroup>
</Project>
